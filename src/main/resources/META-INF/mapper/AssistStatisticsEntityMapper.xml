<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinnlove.springbootall.db.dao.AssistStatisticsRepo">

  <resultMap id="BaseResultMap" type="com.shinnlove.springbootall.db.po.AssistStatisticsEntity">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="guid" jdbcType="BIGINT" property="guid" />
    <result column="receive_point_count" jdbcType="BIGINT" property="receivePointCount" />
    <result column="invite_count" jdbcType="INTEGER" property="inviteCount" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
  </resultMap>

  <select id="getStatisticsByInviteGuid" resultType="com.shinnlove.springbootall.db.po.AssistStatisticsEntity">
    SELECT `guid`, `receive_point_count`, `invite_count`, `create_time`, `update_time`
    FROM ${tableName}
    WHERE `guid` = #{guid}
  </select>

  <insert id="createStatisticsEntity">
    INSERT INTO ${tableName} (`guid`)  VALUES (#{guid})
  </insert>

  <update id="updateInviteCount">
    UPDATE ${tableName}
    SET `invite_count` = `invite_count` + 1
    WHERE `guid` = #{guid}
  </update>

  <update id="updatePointCount">
    UPDATE ${tableName}
    SET `receive_point_count` = `receive_point_count` + #{pointCount}
    WHERE `guid` = #{guid}
  </update>

</mapper>