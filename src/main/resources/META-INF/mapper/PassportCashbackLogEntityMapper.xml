<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinnlove.springbootall.db.dao.PassportCashbackLogRepo">

  <resultMap id="BaseResultMap" type="com.shinnlove.springbootall.db.po.PassportCashbackLogEntity">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="activity_id" jdbcType="VARCHAR" property="activityId" />
    <result column="component_id" jdbcType="BIGINT" property="componentId" />
    <result column="guid" jdbcType="BIGINT" property="guid" />
    <result column="package_type" jdbcType="INTEGER" property="packageType" />
    <result column="member_gear_type" jdbcType="INTEGER" property="memberGearType" />
    <result column="action_queries" jdbcType="VARCHAR" property="actionQueries" />
    <result column="has_sent" jdbcType="INTEGER" property="hasSent" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
  </resultMap>

  <sql id="baseSql">
    `id`, `activity_id`, `component_id`, `guid`, `package_type`, `member_gear_type`, `action_queries`, `has_sent`, `create_time`,`update_time`
  </sql>

  <insert id="insertSelective" useGeneratedKeys="true" keyProperty="entity.id">
    insert into passport_cashback_log (activity_id, component_id, guid, package_type, member_gear_type, action_queries, has_sent)
    values
      (
        #{entity.activityId,jdbcType=VARCHAR},
        #{entity.componentId,jdbcType=BIGINT},
        #{entity.guid,jdbcType=BIGINT},
        #{entity.packageType,jdbcType=INTEGER},
        #{entity.memberGearType,jdbcType=INTEGER},
        #{entity.actionQueries,jdbcType=VARCHAR},
        #{entity.hasSent,jdbcType=INTEGER}
      );
  </insert>

  <select id="queryPassportCashbackLogs" resultMap="BaseResultMap">
    SELECT
    <include refid="baseSql"/>
    from passport_cashback_log
    WHERE `guid` = #{guid} AND `activity_id` = #{activityId}
    ORDER BY `id` DESC;
  </select>

</mapper>