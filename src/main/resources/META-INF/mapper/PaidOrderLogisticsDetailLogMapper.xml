<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinnlove.springbootall.db.dao.PaidOrderLogisticsDetailLogRepo">

  <resultMap id="BaseResultMap" type="com.shinnlove.springbootall.db.po.PaidOrderLogisticsDetailLogEntity">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="express_no" jdbcType="VARCHAR" property="expressNo" />
    <result column="time" jdbcType="TIMESTAMP" property="time" />
    <result column="context" jdbcType="VARCHAR" property="context" />
    <result column="status" jdbcType="VARCHAR" property="status" />
    <result column="city" jdbcType="VARCHAR" property="city" />
    <result column="log_order" jdbcType="INTEGER" property="logOrder" />
    <result column="is_deleted" jdbcType="INTEGER" property="isDeleted" />
    <result column="create_time" jdbcType="TIMESTAMP" property="createTime" />
    <result column="update_time" jdbcType="TIMESTAMP" property="updateTime" />
    <result column="remark" jdbcType="VARCHAR" property="remark" />
  </resultMap>

  <sql id="baseSql">
    `id`, `express_no`, `time`, `context`, `status`, `city`, `log_order`, `is_deleted`, `create_time`,`update_time`, `remark`
  </sql>

  <select id="queryLogisticsLogsByExpressNo" resultMap="BaseResultMap">
    select
    <include refid="baseSql"/>
    from paid_order_logistics_detail_log
    where express_no = #{expressNo}
    and is_deleted = 0
    order by id desc
  </select>

  <insert id="insertSelective" useGeneratedKeys="true" keyProperty="entity.id">
    insert into paid_order_logistics_detail_log (express_no, time, context, status,
                                                 city, log_order, is_deleted)
    values
      (
        #{entity.expressNo,jdbcType=VARCHAR},
        #{entity.time,jdbcType=TIMESTAMP},
        #{entity.context,jdbcType=VARCHAR},
        #{entity.status,jdbcType=VARCHAR},
        #{entity.city,jdbcType=VARCHAR},
        #{entity.logOrder,jdbcType=INTEGER},
        #{entity.isDeleted,jdbcType=INTEGER}
      );
  </insert>

  <update id="deleteOldExpressLogs">
    update paid_order_logistics_detail_log
    set is_deleted = 1
    where express_no = #{expressNo}
  </update>

</mapper>