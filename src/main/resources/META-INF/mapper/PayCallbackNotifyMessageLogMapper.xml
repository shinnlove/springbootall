<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.shinnlove.springbootall.db.dao.PayCallbackNotifyMessageLogRepo">

  <resultMap id="BaseResultMap" type="com.shinnlove.springbootall.db.po.PayCallbackNotifyMessageLogEntity">
    <id column="id" jdbcType="BIGINT" property="id" />
    <result column="queue_name" jdbcType="VARCHAR" property="queueName" />
    <result column="message_body" jdbcType="LONGVARCHAR" property="messageBody" />
    <result column="is_handled" jdbcType="INTEGER" property="isHandled" />
    <result column="created_at" jdbcType="TIMESTAMP" property="createdAt" />
    <result column="updated_at" jdbcType="TIMESTAMP" property="updatedAt" />
  </resultMap>

  <sql id="baseSql">
    `id`, `queue_name`, `message_body`, `is_handled`, `created_at`, `updated_at`
  </sql>

  <insert id="insertSelective" useGeneratedKeys="true" keyProperty="entity.id">
    insert into pay_call_back_notify_message_log (queue_name, message_body)
    values
      (
        #{entity.queueName,jdbcType=VARCHAR},
        #{entity.messageBody,jdbcType=LONGVARCHAR}
      );
  </insert>

</mapper>